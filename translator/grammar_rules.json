[{"name":"固定搭配_一些","description":"将'一些'翻译为'soet'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"一些","replacement":" soet ","example":["一些","soet"]},{"name":"固定搭配_自己_我","description":"将'我自己'翻译为'avi-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"我自己","replacement":" avi-vi ","example":["我自己","avi-vi"]},{"name":"固定搭配_自己_你","description":"将'你自己'翻译为'bign-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"你自己","replacement":" bign-vi ","example":["你自己","bign-vi"]},{"name":"固定搭配_自己_他","description":"将'他自己'翻译为'cinb-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"他自己","replacement":" cinb-vi ","example":["他自己","cinb-vi"]},{"name":"固定搭配_自己_她","description":"将'她自己'翻译为'canb-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"她自己","replacement":" canb-vi ","example":["她自己","canb-vi"]},{"name":"固定搭配_自己_它","description":"将'它自己'翻译为'cenb-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"它自己","replacement":" cenb-vi ","example":["它自己","cenb-vi"]},{"name":"固定搭配_自己_祂","description":"将'祂自己'翻译为'cunk-vi'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"祂自己","replacement":" cunk-vi ","example":["祂自己","cunk-vi"]},{"name":"固定搭配_不是","description":"将'不是'整体翻译为'jot-gis'","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"不是","replacement":" jot-gis ","example":["不是","jot-gis"]},{"name":"固定搭配_的是","description":"处理'xxxx的是yyyy'结构，避免缩写冲突","direction":"toCustom","stage":"pre","category":"fixed-phrase","pattern":"([\\u4e00-\\u9fa5]+)的是([\\u4e00-\\u9fa5]+)","replacement":"$1 uan gis $2","example":["我的是我的","avi uan gis avi"]},{"name":"缩写_的","description":"将中文的'xxxx的yyyy'缩写为'xxxx u-yyyy'，yyyy不能是'是'，且yyyy不能包含'的'或标点","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"([\\u4e00-\\u9fa5]+)的(?!是)([^的。.！!？?\\s]+)","replacement":"$1 u-$2","example":["我的书","a u-book"]},{"name":"缩写_是","description":"将中文的'xxxx是'缩写为'xxxx-$'","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"([\\u4e00-\\u9fa5]+)是","replacement":"$1-$","example":["我是","a-$"]},{"name":"缩写_和是","description":"处理'xxx和yyy是zzz'结构，整体翻译为'xxx-l-yyy gis zzz'，避免'是'被单独缩写","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"([\\u4e00-\\u9fa5]+)和([\\u4e00-\\u9fa5]+)是(.+?)","replacement":"$1-l-$2 gis $3","example":["我和你是个好人","a-l-b gis good person"]},{"name":"缩写_和","description":"将中文的'xxx和yyy'缩写为'xxx-l-yyy'","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"([\\u4e00-\\u9fa5]+)和([\\u4e00-\\u9fa5]+)","replacement":"$1-l-$2","example":["我和你","a-l-b"]},{"name":"缩写_数字个","description":"将'数字个'缩写为'数字-gi'，其中数字为zanum格式","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"(zanum[a-j\\-]+) *个","replacement":"$1-gi","example":["114个","zanuma-d-a-gi"]},{"name":"缩写_不","description":"将'不xxxx'缩写为'jot-xxxx'，xxxx不能是标点或空格","direction":"toCustom","stage":"pre","category":"abbreviation","pattern":"不([^。.！!？?\\s])","replacement":" jot-$1","example":["不想","jot-想"]},{"name":"反向_固定搭配_自己_我","description":"将'avi-vi'恢复为'我自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"avi-vi\\b","replacement":"我自己","example":["avi-vi","我自己"]},{"name":"反向_固定搭配_自己_你","description":"将'bign-vi'恢复为'你自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"bign-vi\\b","replacement":"你自己","example":["bign-vi","你自己"]},{"name":"反向_固定搭配_自己_他","description":"将'cinb-vi'恢复为'他自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"cinb-vi\\b","replacement":"他自己","example":["cinb-vi","他自己"]},{"name":"反向_固定搭配_自己_她","description":"将'canb-vi'恢复为'她自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"canb-vi\\b","replacement":"她自己","example":["canb-vi","她自己"]},{"name":"反向_固定搭配_自己_它","description":"将'cenb-vi'恢复为'它自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"cenb-vi\\b","replacement":"它自己","example":["cenb-vi","它自己"]},{"name":"反向_固定搭配_自己_祂","description":"将'cunk-vi'恢复为'祂自己'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"cunk-vi\\b","replacement":"祂自己","example":["cunk-vi","祂自己"]},{"name":"反向_固定搭配_不是","description":"将'jot-gis'恢复为'不是'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"jot-gis\\b","replacement":"不是","example":["jot-gis","不是"]},{"name":"反向_固定搭配_的是","description":"将'uan gis'恢复为'的是'","direction":"toChinese","stage":"pre","category":"fixed-phrase-reverse","pattern":"uan\\s+gis","replacement":"的是","example":["uan gis","的是"]},{"name":"反向_缩写_是","description":"将'xxx-$'恢复为'xxx是'","direction":"toChinese","stage":"pre","category":"abbreviation-reverse","pattern":"(\\S+)-\\$","replacement":"$1是","example":["avi-$","我是"]},{"name":"反向_缩写_的","description":"将'xxx u-yyy'恢复为'xxx的yyy'","direction":"toChinese","stage":"pre","category":"abbreviation-reverse","pattern":"(\\S+)\\s+u-(\\S+)","replacement":"$1的$2","example":["avi u-book","我的书"]},{"name":"反向_缩写_和","description":"将'xxx-l-yyy'恢复为'xxx和yyy'","direction":"toChinese","stage":"pre","category":"abbreviation-reverse","pattern":"(\\S+)-l-(\\S+)","replacement":"$1和$2","example":["avi-l-bign","我和你"]},{"name":"反向_缩写_数字个","description":"将'数字-gi'恢复为'数字个'","direction":"toChinese","stage":"pre","category":"abbreviation-reverse","pattern":"(zanum[a-j\\-]+)-gi\\b","replacement":"$1 个","example":["zanuma-d-a-gi","114个"]},{"name":"反向_缩写_不","description":"将'jot-xxxx'恢复为'不xxxx'","direction":"toChinese","stage":"pre","category":"abbreviation-reverse","pattern":"jot-(\\S+)","replacement":"不$1","example":["jot-gtik","不想"]}]